# AbsoluteCare environment template
# Copy to backend/.env on the new server and fill in real values. Never commit real secrets.
# Keys below match backend/src/config/env.js and backend/src/config/integrationKeys.js.

# --- Server ---
NODE_ENV= # production | development
PORT=8080 # default 8080
MONGO_URI= # e.g. mongodb://localhost:27017/absolutecare
JWT_SECRET= # long random string; rotating it invalidates sessions and stored credentials
FRONTEND_URL=http://localhost:5173 # where the web app is served from
API_BASE_URL= # e.g. https://api.example.com (used to build OAuth redirect URIs)
ASSETS_BASE_URL= # optional public base URL for uploaded assets
CLINIC_ADDRESS=AbsoluteCare Physical Therapy # shown on emails and paperwork
CORS_ORIGINS= # comma-separated extra origins, if any
SEED_PASSWORD= # initial admin password used by the seed script only
ADMIN_EMAILS= # comma-separated Google sign-in addresses that are always active admins; e.g. owner@clinic.com

# --- Google sign-in (managed in Settings > Integrations) ---
GOOGLE_CLIENT_ID= # ends in .apps.googleusercontent.com
GOOGLE_CLIENT_SECRET= # server-side only
GOOGLE_SECRET_KEY= # legacy alias of the client secret; prefer GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI= # defaults to ${API_BASE_URL}/auth/google/callback; set explicitly to override

# --- reCAPTCHA (managed in Settings > Integrations) ---
RECAPTCHA_SITE_KEY= # public; shipped to the browser
RECAPTCHA_SECRET_KEY= # server-side only

# --- Google Calendar (managed in Settings > Integrations) ---
GOOGLE_CALENDAR_REDIRECT_URI= # defaults to ${API_BASE_URL}/integrations/google-calendar/callback; set explicitly to override
GOOGLE_CALENDAR_ENCRYPTION_KEY= # at least 16 random characters; rotation disconnects calendars

# --- Email provider (managed in Settings > Integrations) ---
SMTP_HOST=smtp.gmail.com # default smtp.gmail.com
SMTP_PORT=465 # default 465 (587 for STARTTLS)
SMTP_SECURE= # true | false; blank derives from the port
SMTP_USER= # usually the full sending address
SMTP_PASS= # canonical SMTP password; Gmail needs a 16-character App Password
SMTP_PASSWORD= # legacy alias of SMTP_PASS; prefer SMTP_PASS
MAIL_FROM= # Name <name@clinic.com> or bare address
GMAIL_USER= # Gmail OAuth path only
GMAIL_CLIENT_ID= # Gmail OAuth path only
GMAIL_CLIENT_SECRET= # Gmail OAuth path only
GMAIL_APP_PASSWORD= # Gmail OAuth path only
GMAIL_REFRESH_TOKEN= # Gmail OAuth path only

# --- Integration settings plumbing (not edited on the credentials page) ---
CREDENTIAL_ENCRYPTION_KEY= # encrypts stored credentials; keep secret and stable
ALLOW_SELF_RESTART=false # set true only under a supervisor (pm2 / systemd / docker)
ENV_WRITE=on # set off to keep backend/.env read-only (DB stays authoritative)
INTEGRATION_VALIDATION=on # set off in local development to skip live provider checks
