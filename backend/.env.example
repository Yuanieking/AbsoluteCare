# PORT USED BY SERVER
PORT=8080

# DATABASE
MONGO_URI=mongodb://localhost:27017/absolutecare

# ECAPTCHA
RECAPTCHA_SITE_KEY=replace-with-google-recaptcha-site-key
RECAPTCHA_SECRET_KEY=replace-with-google-recaptcha-secret-key

# GOOGLE AUTH
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_SECRET_KEY=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
FRONTEND_URL=http://localhost:5173
ASSETS_BASE_URL=https://api.example.com
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret

# MAILER
# SMTP_PASS is preferred. SMTP_PASSWORD and the GMAIL_* names remain supported.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
MAIL_FROM=AbsoluteCare Therapy Center <your-gmail-address@gmail.com>

# Legacy Gmail aliases:
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
# Or use Gmail OAuth2 instead of GMAIL_APP_PASSWORD:
# GMAIL_CLIENT_ID=replace-with-google-oauth-client-id
# GMAIL_CLIENT_SECRET=replace-with-google-oauth-client-secret
# GMAIL_REFRESH_TOKEN=replace-with-gmail-refresh-token
